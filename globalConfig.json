{
    "pages": {
        "configuration": {
            "tabs": [
                {
                    "name": "account",
                    "restHandlerModule": "ontap_vserver_validator_rh",
                    "restHandlerClass": "CustomAccountValidator",
                    "table": {
                        "actions": [
                            "edit",
                            "delete",
                            "clone"
                        ],
                        "header": [
                            {
                                "label": "Name",
                                "field": "name"
                            },
                            {
                                "label": "Host",
                                "field": "host"
                            },
                            {
                                "label": "Username",
                                "field": "username"
                            },
                            {
                                "label": "Server Status",
                                "field": "server_status"
                            },
                            {
                                "label": "Status",
                                "field": "disabled"
                            }
                        ]
                    },
                    "entity": [
                        {
                            "type": "text",
                            "label": "Name",
                            "field": "name",
                            "help": "A unique name for the account.",
                            "required": true
                        },
                        {
                            "type": "text",
                            "label": "ONTAP Host",
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of input name should be between 1 and 100",
                                    "minLength": 1,
                                    "maxLength": 100
                                }
                            ],
                            "field": "host",
                            "help": "ONTAP service base URL",
                            "required": true
                        },
                        {
                            "type": "text",
                            "label": "Username",
                            "field": "username",
                            "help": "Username",
                            "required": true
                        },
                        {
                            "type": "text",
                            "label": "Password",
                            "field": "password",
                            "help": "Password",
                            "required": true,
                            "encrypted": true
                        },
                        {
                            "type": "checkbox",
                            "label": "Verify Host Connections",
                            "field": "verify_host",
                            "defaultValue": true
                        },
                        {
                            "type": "checkbox",
                            "label": "Verify TLS Certificates",
                            "field": "verify_tls",
                            "help": "Validate the ONTAP server TLS certificate when connecting.",
                            "defaultValue": false
                        },
                        {
                            "type": "text",
                            "label": "Server Status",
                            "field": "server_status",
                            "help": "Server status",
                            "defaultValue": "Unknown",
                            "options": {
                                "disableonEdit": true,
                                "display": false
                            }
                        }
                    ],
                    "title": "Accounts"
                },
                {
                    "name": "data_collection",
                    "title": "Data Collection",
                    "restHandlerModule": "ontap_data_collection_rh",
                    "restHandlerClass": "DataCollectionHandler",
                    "entity": [
                        {
                            "type": "singleSelect",
                            "label": "Account",
                            "field": "account",
                            "options": {
                                "referenceName": "account"
                            },
                            "help": "Select the ONTAP account to collect data from.",
                            "tooltip": "The account must be configured on the Accounts tab first.",
                            "required": false
                        },
                        {
                            "type": "singleSelect",
                            "label": "Index",
                            "field": "index",
                            "defaultValue": "default",
                            "options": {
                                "endpointUrl": "data/indexes",
                                "denyList": "^_.*$",
                                "createSearchChoice": true
                            },
                            "validators": [
                                {
                                    "type": "string",
                                    "errorMsg": "Length of index name should be between 1 to 80 characters.",
                                    "minLength": 1,
                                    "maxLength": 80
                                }
                            ],
                            "required": true
                        },
                        {
                            "type": "interval",
                            "label": "Interval",
                            "field": "interval",
                            "defaultValue": "300",
                            "options": {
                                "range": [
                                    10,
                                    3600
                                ]
                            },
                            "help": "Collection interval in seconds.",
                            "required": true
                        },
                        {
                            "type": "interval",
                            "label": "Request Timeout",
                            "field": "request_timeout",
                            "defaultValue": "30",
                            "options": {
                                "range": [
                                    1,
                                    300
                                ]
                            },
                            "help": "ONTAP REST request timeout in seconds.",
                            "required": true
                        },
                        {
                            "type": "checkbox",
                            "label": "Collect qtrees",
                            "field": "collect_qtrees",
                            "defaultValue": true,
                            "help": "Enable collection of qtrees data."
                        },
                        {
                            "type": "checkbox",
                            "label": "Collect aggregates",
                            "field": "collect_aggregates",
                            "defaultValue": true,
                            "help": "Enable collection of aggregates data."
                        },
                        {
                            "type": "checkbox",
                            "label": "Collect volumes",
                            "field": "collect_volume",
                            "defaultValue": true,
                            "help": "Enable collection of volume data."
                        },
                        {
                            "type": "checkbox",
                            "label": "Collect SVMs",
                            "field": "collect_svms",
                            "defaultValue": true,
                            "help": "Enable collection of SVMs data."
                        },
                        {
                            "type": "checkbox",
                            "label": "Collect cluster nodes",
                            "field": "collect_cluster_nodes",
                            "defaultValue": true,
                            "help": "Enable collection of cluster nodes data."
                        },
                        {
                            "type": "checkbox",
                            "label": "Collect cluster identity",
                            "field": "collect_cluster_identity",
                            "defaultValue": true,
                            "help": "Enable collection of cluster identity data."
                        }
                    ]
                },
                {
                    "type": "loggingTab"
                }
